<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Bee Languages | Inglês personalizado para a vida real</title>
<meta name="description" content="Aprenda inglês com a Teacher Anne por meio de aulas personalizadas, práticas e conectadas à vida real. Desenvolva listening, speaking e confiança para se comunicar.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Kalam:wght@400;700&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F6EFE0; --paper2:#EFE3C9; --paper3:#FBF6EA;
  --ink:#2A2118; --ink-soft:#5B5041;
  --honey:#E7A93F; --honey-dark:#C6871F;
  --terracotta:#C05B3C; --sage:#8C9B78; --wood:#A9835C; --lilac:#B7A6CB;
  --serif:'Fraunces',Georgia,serif;
  --hand:'Kalam',cursive;
  --sans:'Karla',system-ui,sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:inherit; margin:0; padding:0;}
html{scroll-behavior:smooth; scroll-padding-top:calc(72px + env(safe-area-inset-top,0px));}
body{
  background:var(--paper); color:var(--ink); font-family:var(--sans); font-size:17px; line-height:1.55;
  background-image:
    radial-gradient(rgba(42,33,24,.025) 1px, transparent 1px),
    radial-gradient(rgba(42,33,24,.02) 1px, transparent 1px);
  background-size:3px 3px, 7px 7px; background-position:0 0, 2px 3px;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ } }
img,svg{max-width:100%; display:block;}
.wrap{max-width:1120px; margin:0 auto; padding:0 24px;}
h1,h2,h3{font-family:var(--serif); font-weight:600; line-height:1.15; letter-spacing:-.01em;}
h2{font-size:clamp(28px,4.4vw,44px); font-style:italic; font-weight:500;}
h3{font-size:22px;}
p{max-width:62ch;}
a{color:inherit;}
.eyebrow{font-family:var(--hand); font-size:1.15rem; color:var(--terracotta); display:inline-block; transform:rotate(-2deg);}

/* underline squiggle */
.sq{position:relative; white-space:nowrap;}
.sq svg{position:absolute; left:0; bottom:-6px; width:100%; height:10px;}

/* buttons */
.btn{font-family:var(--sans); font-weight:700; font-size:.95rem; padding:14px 26px; border-radius:100px; border:2px solid var(--ink); cursor:pointer; display:inline-flex; align-items:center; gap:8px; text-decoration:none; transition:transform .15s ease;}
.btn:hover{transform:translateY(-2px) rotate(-.6deg);}
.btn-fill{background:var(--ink); color:var(--paper3);}
.btn-hollow{background:transparent; color:var(--ink);}
.btn-honey{background:var(--honey); border-color:var(--ink); color:var(--ink);}
.btn-wa{background:#e9f3ea; border-color:#4c7a52; color:#2f5233;}
.btn-sm{padding:10px 18px; font-size:.85rem;}

/* header */
header{position:sticky; top:0; z-index:50; background:rgba(246,239,224,.92); backdrop-filter:blur(6px); border-bottom:2px solid var(--ink); padding:env(safe-area-inset-top,0px) 0 0;}
.nav{display:flex; align-items:center; justify-content:space-between; padding:14px 24px; max-width:1120px; margin:0 auto;}
.logo{display:flex; align-items:center; gap:8px; font-family:var(--serif); font-weight:700; font-size:1.3rem;}
.logo svg{width:30px; height:30px;}
.navlinks{display:none; gap:26px; font-weight:600; font-size:.95rem;}
.navlinks a{text-decoration:none; border-bottom:2px solid transparent;}
.navlinks a:hover{border-color:var(--honey);}
.burger{display:block; background:none; border:2px solid var(--ink); border-radius:10px; width:42px; height:38px; font-size:1.3rem;}
#navtoggle{display:none;}
.mobilemenu{display:none; flex-direction:column; gap:14px; padding:16px 24px 22px; border-top:2px solid var(--ink); font-weight:600;}
.mobilemenu a{text-decoration:none;}
#navtoggle:checked ~ .mobilemenu{display:flex;}
@media(min-width:820px){ .navlinks{display:flex;} .burger{display:none;} }

/* section spacing */
section{padding:76px 0; position:relative;}
.note{background:var(--paper3); border:2px solid var(--ink); border-radius:3px; padding:22px 24px; position:relative; box-shadow:5px 6px 0 rgba(42,33,24,.12);}
.pin{position:absolute; top:-14px; width:22px; height:22px;}
.tape{position:absolute; width:70px; height:26px; background:rgba(231,169,63,.55); border:1px solid rgba(42,33,24,.15); top:-14px; left:50%; transform:translateX(-50%) rotate(-3deg); box-shadow:0 1px 2px rgba(0,0,0,.1);}

/* HERO */
.hero{padding-top:56px; text-align:center;}
.hero .doodleline{font-family:var(--hand); color:var(--terracotta); font-size:1.3rem; transform:rotate(-2deg); display:inline-block; margin-bottom:8px;}
.hero h1{font-size:clamp(34px,6vw,58px); max-width:16ch; margin:6px auto 18px; font-style:italic;}
.hero p.lead{max-width:52ch; margin:0 auto 30px; font-size:1.15rem; color:var(--ink-soft);}
.hero-ctas{display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin-bottom:44px;}
.hero-visual{display:flex; align-items:center; justify-content:center; gap:0; position:relative; margin-top:10px;}
.photo-frame{width:min(78vw,300px); aspect-ratio:4/5; background:linear-gradient(135deg,#e7dcc0,#dccfa9); border:3px solid var(--ink); position:relative; transform:rotate(-2deg); box-shadow:6px 8px 0 rgba(42,33,24,.15);}
.photo-frame .tape{top:-16px;}
.photo-frame .eyes{position:absolute; bottom:14px; left:50%; transform:translateX(-50%);}
.photo-frame .cap{position:absolute; bottom:-14px; right:-10px; background:var(--paper3); border:2px solid var(--ink); padding:4px 10px; font-family:var(--hand); font-size:1rem; transform:rotate(3deg);}
.bee-fly{width:64px; position:absolute; top:-24px; right:-6px; transform:rotate(12deg);}

/* PROBLEM */
.problem{background:var(--paper2); border-top:2px solid var(--ink); border-bottom:2px solid var(--ink);}
.problem .grid2{display:grid; gap:36px;}
@media(min-width:820px){.problem .grid2{grid-template-columns:1fr 1fr; align-items:start;}}
.chips{display:flex; flex-wrap:wrap; gap:10px; margin-top:20px;}
.chip{background:var(--paper3); border:2px solid var(--ink); border-radius:100px; padding:8px 16px; font-family:var(--hand); font-size:1.02rem;}
.chip:nth-child(2n){transform:rotate(-1.5deg);}
.chip:nth-child(3n){transform:rotate(1.5deg);}
.closing{font-family:var(--serif); font-style:italic; font-size:1.3rem; margin-top:22px;}

/* WELCOME */
.welcome{text-align:center;}
.diffs{display:grid; gap:16px; grid-template-columns:1fr; margin-top:40px; text-align:left;}
@media(min-width:700px){.diffs{grid-template-columns:1fr 1fr 1fr;}}
.diff-card{border:2px solid var(--ink); background:var(--paper3); padding:18px; border-radius:3px; box-shadow:4px 5px 0 rgba(42,33,24,.1);}
.diff-card svg{width:26px; height:26px; margin-bottom:10px;}

/* TEACHER */
.teacher .grid2{display:grid; gap:44px; align-items:center;}
@media(min-width:820px){.teacher .grid2{grid-template-columns:.85fr 1.15fr;}}
.teacher .photo-frame{margin:0 auto; transform:rotate(2deg);}
.badge-list{list-style:none; margin-top:20px; display:grid; gap:10px;}
.badge-list li{display:flex; gap:10px; align-items:flex-start; font-weight:500;}
.badge-list svg{width:18px; height:18px; flex-shrink:0; margin-top:4px; color:var(--terracotta);}

/* METHOD */
.method{background:var(--paper2); border-top:2px solid var(--ink); border-bottom:2px solid var(--ink);}
.principles{display:grid; gap:18px; margin-top:40px; grid-template-columns:1fr;}
@media(min-width:700px){.principles{grid-template-columns:1fr 1fr;}}
@media(min-width:1000px){.principles{grid-template-columns:1fr 1fr 1fr;}}
.pcard{background:var(--paper3); border:2px dashed var(--wood); padding:18px 20px; border-radius:3px;}
.pcard .num{font-family:var(--hand); color:var(--terracotta); font-size:1.4rem;}

/* JOURNEY */
.journey ol{list-style:none; margin-top:44px; position:relative; padding-left:26px; border-left:3px dashed var(--wood);}
.journey li{position:relative; padding-bottom:34px; padding-left:22px;}
.journey li:last-child{padding-bottom:0;}
.journey li::before{content:"🐝"; position:absolute; left:-40px; top:-2px; font-size:1.1rem;}
.journey h3{font-family:var(--hand); font-weight:700; color:var(--terracotta); font-size:1.3rem; margin-bottom:4px;}

/* INCLUDED */
.included ul{list-style:none; margin-top:32px; display:grid; gap:12px; grid-template-columns:1fr;}
@media(min-width:700px){.included ul{grid-template-columns:1fr 1fr;}}
.included li{display:flex; gap:10px; align-items:flex-start; font-weight:500;}
.included svg{width:18px; height:18px; margin-top:5px; flex-shrink:0; color:var(--sage);}

/* PLANS */
.plans{background:var(--paper2); border-top:2px solid var(--ink); border-bottom:2px solid var(--ink);}
.plangrid{display:grid; gap:26px; margin-top:44px; grid-template-columns:1fr;}
@media(min-width:900px){.plangrid{grid-template-columns:1fr 1fr 1fr;}}
.plancard{background:var(--paper3); border:2px solid var(--ink); border-radius:4px; padding:26px 22px; box-shadow:6px 7px 0 rgba(42,33,24,.12);}
.plancard svg.icon{width:34px; height:34px; color:var(--terracotta);}
.plancard h3{margin-top:12px; font-style:italic;}
.plancard .concept{font-family:var(--hand); color:var(--honey-dark); font-size:1.1rem; margin-top:2px;}
.plancard .meta{margin-top:14px; font-size:.92rem; color:var(--ink-soft); font-weight:600;}
.plancard p.desc{margin-top:12px; font-size:.96rem;}
.plancard details{margin-top:16px; border-top:2px dashed var(--wood); padding-top:14px;}
.plancard summary{cursor:pointer; font-weight:700; list-style:none; display:flex; justify-content:space-between; align-items:center;}
.price-toggle{margin:14px 0;}
.plancard .price-toggle summary{display:inline-flex; justify-content:flex-start; width:fit-content; background:var(--honey); border:2px solid var(--ink); color:var(--ink); font-family:var(--sans); font-size:.92rem; padding:10px 18px; border-radius:100px;}
.plancard .price-toggle summary::after{content:none;}
.price-value{margin-top:10px; font-family:var(--hand); font-size:1.6rem; color:var(--ink); background:var(--paper3); border:2px dashed var(--honey-dark); border-radius:8px; padding:10px 14px; display:inline-block;}
.price-value span{font-size:1rem; font-family:var(--sans);}
.price-value small{display:block; font-family:var(--sans); font-size:.85rem; color:#5b5045; margin-top:2px;}
.plancard summary::-webkit-details-marker{display:none;}
.plancard summary::after{content:"+"; font-size:1.4rem; font-family:var(--serif);}
.plancard details[open] summary::after{content:"–";}
.plancard .inner{margin-top:14px; font-size:.93rem;}
.plancard .inner h4{font-family:var(--hand); font-size:1.05rem; color:var(--terracotta); margin:12px 0 6px;}
.plancard .inner ul{padding-left:20px;}
.plancard .inner li{margin-bottom:4px;}
.plan-ctas{margin-top:16px; display:flex; flex-direction:column; gap:8px;}

/* MODALITIES */
.modgrid{display:grid; gap:20px; margin-top:36px; grid-template-columns:1fr;}
@media(min-width:700px){.modgrid{grid-template-columns:1fr 1fr;}}
.modcard{border:2px solid var(--ink); background:var(--paper3); padding:24px; border-radius:3px;}
.modcard svg{width:30px; height:30px; color:var(--sage);}
.modcard .flag{display:inline-block; margin-top:12px; font-family:var(--hand); font-size:.9rem; background:var(--honey); border:1px solid var(--ink); padding:3px 10px; border-radius:100px; transform:rotate(-1deg);}

/* WHO */
.who{background:var(--paper2); border-top:2px solid var(--ink); border-bottom:2px solid var(--ink);}

/* FAQ */
.faqlist{margin-top:36px; display:grid; gap:12px;}
.faqlist details{background:var(--paper3); border:2px solid var(--ink); border-radius:3px; padding:16px 18px;}
.faqlist summary{cursor:pointer; font-weight:700; font-family:var(--serif); list-style:none;}
.faqlist summary::-webkit-details-marker{display:none;}
.faqlist summary::before{content:"🐝 "; }
.faqlist .a{margin-top:10px; font-size:.96rem; color:var(--ink-soft);}
.edit-flag{font-family:var(--hand); color:var(--terracotta); font-size:.85rem;}

/* FINAL CTA */
.finalcta{text-align:center;}
.finalcta .hivebox{background:var(--ink); color:var(--paper3); border-radius:6px; padding:60px 28px; position:relative; overflow:hidden;}
.finalcta h2{color:var(--paper3); font-style:italic;}
.finalcta p{color:#e7ddc5; margin:14px auto 26px;}
.finalcta svg.bee{width:52px; margin:0 auto 14px; color:var(--honey);}
.finalcta .btn-honey{border-color:var(--paper3);}
.finalcta .btn-hollow{border-color:var(--paper3); color:var(--paper3);}
.seehive{font-family:var(--hand); font-size:1.05rem; margin-top:22px; color:var(--honey);}

/* FORM */
.formsection .grid2{display:grid; gap:40px;}
@media(min-width:900px){.formsection .grid2{grid-template-columns:1fr 1fr;}}
form{display:grid; gap:14px; margin-top:24px;}
label{font-weight:700; font-size:.88rem; display:block; margin-bottom:5px;}
input,select,textarea{width:100%; font-family:var(--sans); font-size:.95rem; padding:11px 12px; border:2px solid var(--ink); border-radius:4px; background:var(--paper3); color:var(--ink);}
textarea{min-height:80px; resize:vertical;}
.wa-box{margin-top:24px; background:var(--paper3); border:2px solid var(--ink); border-radius:4px; padding:20px;}
#confirmMsg{display:none; margin-top:16px; background:#e9f3ea; border:2px solid #4c7a52; border-radius:4px; padding:14px 16px; font-weight:600; color:#2f5233;}

/* footer */
footer{border-top:2px solid var(--ink); padding:34px 0; font-size:.85rem; color:var(--ink-soft);}
.footgrid{display:flex; flex-wrap:wrap; justify-content:space-between; gap:14px; align-items:center;}

.rot1{transform:rotate(-1.5deg);} .rot2{transform:rotate(1.5deg);}
::selection{background:var(--honey); color:var(--ink);}

.emo{font-family:"Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif;font-style:normal;line-height:1}
.emo.big{font-size:1.9rem;display:block;margin-bottom:8px}.emo.icon{font-size:2.2rem;display:block}
.badge-list .emo{font-size:1.15rem;margin-top:3px}
.photo-frame{overflow:visible}.photo-frame .ph{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.photo-frame .tape,.photo-frame .cap,.photo-frame .bee-fly{z-index:3}
.incl-grid{margin-top:28px;display:grid;gap:14px;grid-template-columns:1fr}
@media(min-width:700px){.incl-grid{grid-template-columns:1fr 1fr}}@media(min-width:1000px){.incl-grid{grid-template-columns:repeat(4,1fr)}}
.incl-card{background:var(--paper3);border:2px solid var(--ink);border-radius:4px;padding:18px;box-shadow:5px 6px 0 rgba(42,33,24,.12)}
.incl-card:nth-child(2n){transform:rotate(-.8deg)}.incl-card:nth-child(3n){transform:rotate(.8deg)}
.incl-card h3{font-size:1.05rem}.incl-card p{font-size:.9rem;margin-top:6px}
.ptable{width:100%;border-collapse:collapse;margin:10px 0;font-size:.92rem;background:var(--paper3)}
.ptable th,.ptable td{border:2px solid var(--ink);padding:7px 8px;text-align:left}
.ptable th{background:var(--honey);font-family:var(--sans)}.ptable small{font-size:.75rem;color:#5b5045}
.ptable tr.best td{background:#FBE9A6;font-weight:700}
.pnote{font-size:.82rem;color:#5b5045;margin-top:4px}
.faqtable{overflow-x:auto;margin-top:10px}
.groups{background:var(--paper2)}
.band{background:var(--ink);color:var(--paper);text-align:center;padding:84px 0}.band h2{font-style:normal;font-weight:700;font-size:clamp(32px,7vw,64px);text-transform:uppercase;line-height:1.05}.band p{margin:16px auto 0;color:#eadfc8}.band.honey{background:var(--honey);color:var(--ink)}.band.honey p{color:var(--ink)}.hl2{color:var(--honey)}
.hl{background:linear-gradient(transparent 62%,var(--honey) 62%)}.bigline{font-family:var(--serif);font-style:italic;font-size:clamp(22px,3.6vw,32px);margin-top:22px;max-width:30ch}
.metodobee,.realeng,.skillsec,.difsec,.roadmap{padding:76px 0}.realeng{background:var(--paper2);border-top:2px solid var(--ink);border-bottom:2px solid var(--ink)}
.chips{display:flex;flex-wrap:wrap;gap:8px}.center{text-align:center}.center .chips{justify-content:center}
.flow{display:flex;flex-direction:column;align-items:center;gap:6px;margin-top:26px}.flow .stop{background:var(--paper3);border:2px solid var(--ink);border-radius:4px;padding:14px 22px;font-family:var(--serif);font-size:1.15rem;min-width:min(320px,100%);box-shadow:4px 5px 0 rgba(42,33,24,.12)}.flow .arr{font-size:1.6rem;color:var(--terracotta)}
.skills{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:28px}@media(min-width:700px){.skills{grid-template-columns:repeat(3,1fr)}}.skills div{background:var(--paper3);border:2px solid var(--ink);border-radius:4px;padding:16px 8px}.skills .emo.big{margin-bottom:4px}
.review{margin:36px auto 0;max-width:640px;text-align:center}.review p{margin-inline:auto}
.plus{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:8px 10px;margin:26px auto 0;max-width:820px}.plus span{background:var(--paper3);border:2px solid var(--ink);border-radius:100px;padding:8px 16px;font-weight:700;font-size:.95rem}.plus span:not(:last-child)::after{content:"+";margin-left:12px;color:var(--terracotta);font-family:var(--serif)}
.valor{padding:130px 0;background:var(--paper)}.valor p{font-family:var(--serif);font-size:clamp(24px,4.2vw,40px);line-height:1.3;max-width:24ch;margin:0 auto;font-weight:500}.valor .v2{margin-top:30px;font-style:italic;color:var(--terracotta);max-width:34ch}
.plancard .emo.icon{margin-bottom:10px}
.plancard details.sub{margin-top:12px;border:2px solid var(--ink);border-radius:4px;background:var(--paper)}.plancard details.sub>summary{padding:12px 14px;font-weight:700}.inner2{padding:4px 14px 14px}.plancard .meta{margin-top:4px}
</style>
</head>
<body>

